{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anki-study-report.local/schemas/gamification-error-v1.schema.json",
  "title": "GamificationErrorV1",
  "description": "Bounded error envelope for future token-protected Study Rhythm endpoints.",
  "oneOf": [
    {
      "$ref": "#/$defs/invalidRequest"
    },
    {
      "$ref": "#/$defs/forbidden"
    },
    {
      "$ref": "#/$defs/revisionConflict"
    },
    {
      "$ref": "#/$defs/gamificationUnavailable"
    },
    {
      "$ref": "#/$defs/storeUnavailable"
    }
  ],
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "isoWeekday": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "fieldMessage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "fieldErrors": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 7,
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/fieldMessage"
        },
        "expectedRevision": {
          "$ref": "#/$defs/fieldMessage"
        },
        "operation": {
          "$ref": "#/$defs/fieldMessage"
        },
        "enabled": {
          "$ref": "#/$defs/fieldMessage"
        },
        "weeklyTargetDays": {
          "$ref": "#/$defs/fieldMessage"
        },
        "plannedRestWeekdays": {
          "$ref": "#/$defs/fieldMessage"
        },
        "feedbackEnabled": {
          "$ref": "#/$defs/fieldMessage"
        }
      }
    },
    "publicSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "revision",
        "enabled",
        "weeklyTargetDays",
        "plannedRestWeekdays",
        "feedbackEnabled",
        "source"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "revision": {
          "$ref": "#/$defs/safeInteger"
        },
        "enabled": {
          "type": "boolean"
        },
        "weeklyTargetDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "plannedRestWeekdays": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/isoWeekday"
          }
        },
        "feedbackEnabled": {
          "type": "boolean"
        },
        "source": {
          "enum": [
            "default",
            "stored",
            "recovered_default"
          ]
        }
      }
    },
    "invalidRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "ok",
        "error",
        "message"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "ok": {
          "const": false
        },
        "error": {
          "const": "invalid_gamification_request"
        },
        "message": {
          "$ref": "#/$defs/message"
        },
        "fieldErrors": {
          "$ref": "#/$defs/fieldErrors"
        }
      }
    },
    "forbidden": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "ok",
        "error",
        "message"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "ok": {
          "const": false
        },
        "error": {
          "const": "forbidden"
        },
        "message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "revisionConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "ok",
        "error",
        "message",
        "currentRevision",
        "currentSettings"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "ok": {
          "const": false
        },
        "error": {
          "const": "gamification_revision_conflict"
        },
        "message": {
          "$ref": "#/$defs/message"
        },
        "currentRevision": {
          "$ref": "#/$defs/safeInteger"
        },
        "currentSettings": {
          "$ref": "#/$defs/publicSettings"
        }
      }
    },
    "gamificationUnavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "ok",
        "error",
        "message"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "ok": {
          "const": false
        },
        "error": {
          "const": "gamification_unavailable"
        },
        "message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "storeUnavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "ok",
        "error",
        "message"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "ok": {
          "const": false
        },
        "error": {
          "const": "gamification_store_unavailable"
        },
        "message": {
          "$ref": "#/$defs/message"
        }
      }
    }
  }
}

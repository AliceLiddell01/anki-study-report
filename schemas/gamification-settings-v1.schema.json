{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anki-study-report.local/schemas/gamification-settings-v1.schema.json",
  "title": "GamificationSettingsDocumentV1",
  "description": "Persisted Study Rhythm settings document. Public responses add a non-persisted source field in the model contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "enabled",
    "weeklyTargetDays",
    "plannedRestWeekdays",
    "feedbackEnabled"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "$ref": "#/$defs/safeInteger"
    },
    "enabled": {
      "type": "boolean"
    },
    "weeklyTargetDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "plannedRestWeekdays": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/isoWeekday"
      }
    },
    "feedbackEnabled": {
      "type": "boolean"
    }
  },
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "isoWeekday": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    }
  }
}
